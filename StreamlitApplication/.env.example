# Optional environment configuration for FinMate
# REPORT_AUTHOR will be used as the PDF author metadata if set
REPORT_AUTHOR=FinMate

# Optional: override port/address used by Streamlit entrypoint
# STREAMLIT_PORT defaults to 3000; STREAMLIT_ADDRESS defaults to 0.0.0.0
# STREAMLIT_PORT=3000
# STREAMLIT_ADDRESS=0.0.0.0
